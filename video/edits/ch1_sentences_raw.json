[
 {
  "start": 0.0,
  "end": 2.5,
  "text": "Laila is made-up."
 },
 {
  "start": 2.7,
  "end": 5.4,
  "text": "Everything about her is real."
 },
 {
  "start": 5.7,
  "end": 7.4,
  "text": "She's 34,"
 },
 {
  "start": 7.4,
  "end": 9.1,
  "text": "she lives in Dubai"
 },
 {
  "start": 9.1,
  "end": 12.0,
  "text": "and every 8 weeks she colors her hair."
 },
 {
  "start": 12.1,
  "end": 13.9,
  "text": "Sometimes at the salon,"
 },
 {
  "start": 13.9,
  "end": 16.4,
  "text": "sometimes with a box from the pharmacy."
 },
 {
  "start": 16.5,
  "end": 17.6,
  "text": "Both work,"
 },
 {
  "start": 17.6,
  "end": 21.0,
  "text": "neither tells her what's happening to her hair in between."
 },
 {
  "start": 21.1,
  "end": 23.3,
  "text": "That's what ProGo changes."
 },
 {
  "start": 23.5,
  "end": 25.7,
  "text": "A 12-week care subscription."
 },
 {
  "start": 25.8,
  "end": 27.6,
  "text": "We measure her hair."
 },
 {
  "start": 27.7,
  "end": 31.7,
  "text": "A professional from her own salon comes to her home, twice."
 },
 {
  "start": 32.2,
  "end": 34.9,
  "text": "12 weeks later we measure again."
 },
 {
  "start": 35.1,
  "end": 37.8,
  "text": "If it didn't work she sees it."
 },
 {
  "start": 37.8,
  "end": 38.8,
  "text": "So do we."
 },
 {
  "start": 39.4,
  "end": 42.1,
  "text": "L'Or\u00e9al can do most of this already."
 },
 {
  "start": 42.2,
  "end": 43.6,
  "text": "The science,"
 },
 {
  "start": 43.6,
  "end": 44.8,
  "text": "the products,"
 },
 {
  "start": 44.8,
  "end": 46.5,
  "text": "the salons that already trust us."
 },
 {
  "start": 46.7,
  "end": 49.6,
  "text": "What we can't do is the hard part in the middle,"
 },
 {
  "start": 49.7,
  "end": 53.6,
  "text": "getting a licensed professional into a private home in Dubai."
 },
 {
  "start": 54.0,
  "end": 57.5,
  "text": "On time, insured, with the right permit."
 },
 {
  "start": 57.8,
  "end": 60.9,
  "text": "A home visit there need its own permission"
 },
 {
  "start": 61.0,
  "end": 63.3,
  "text": "and the staff need the right approvals."
 },
 {
  "start": 63.8,
  "end": 65.5,
  "text": "We have never run that"
 },
 {
  "start": 65.5,
  "end": 68.3,
  "text": "and Laila's living room is not the place to learn."
 },
 {
  "start": 68.7,
  "end": 70.3,
  "text": "We could build it,"
 },
 {
  "start": 70.3,
  "end": 71.1,
  "text": "buy it"
 },
 {
  "start": 71.1,
  "end": 72.1,
  "text": "or partner."
 },
 {
  "start": 72.3,
  "end": 74.0,
  "text": "Building takes years."
 },
 {
  "start": 74.2,
  "end": 79.9,
  "text": "Buying a home-service company would put L'Or\u00e9al between the salon and its client."
 },
 {
  "start": 80.3,
  "end": 85.8,
  "text": "So we partner with someone who already does it every day."
 }
]